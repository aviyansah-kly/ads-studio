{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ads-studio",
  "compatibility_date": "2026-08-18",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  }
}
